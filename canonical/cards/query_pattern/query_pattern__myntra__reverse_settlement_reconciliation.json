  "sql_ref": "sql.myntra.reverse_settlement_reconciliation",
  "sql_template": "SELECT r.order_id, r.item_id,\n       SUM(COALESCE(r.refund_amount, 0)) AS expected_refund_amount,\n       SUM(COALESCE(s.settled_amount, 0)) AS reverse_settlement_amount,\n       SUM(COALESCE(s.settled_amount, 0)) - SUM(COALESCE(r.refund_amount, 0)) AS variance_amount,\n       CASE WHEN COUNT(s.order_id) = 0 THEN 'reverse_missing_settlement' ELSE 'matched_or_amount_review' END AS recon_status\nFROM zs_observe.myntra_reverse r\nLEFT JOIN zs_refined.myntra_settlement s\n  ON r.order_id = s.order_id\n AND r.item_id = s.item_id\n AND s.transaction_type = 'reverse'\n AND s.is_active = true\n AND s.group_level_id = r.group_level_id\nWHERE r.is_active = true\n  AND r.group_level_id = <client_id>\nGROUP BY r.order_id, r.item_id;",
