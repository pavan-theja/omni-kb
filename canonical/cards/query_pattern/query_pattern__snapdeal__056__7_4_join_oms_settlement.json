  "sql_pattern_id": "sql.snapdeal.7_4_join_oms_settlement",
  "sql_template": "SELECT\n  o.suborder_code,\n  o.invoice_number,\n  o.charged_amount AS oms_charged,\n  s.settled_amount AS settled,\n  s.commission,\n  s.courier_fee\nFROM zs_observe.snapdeal_oms o\nLEFT JOIN zs_observe.snapdeal_settlement s\n  ON o.invoice_number = s.invoice_number\n  AND s.is_active = true\n  AND s.transaction_type = 'forward'\nWHERE o.is_active = true\n  AND o.transaction_type = 'forward';",
