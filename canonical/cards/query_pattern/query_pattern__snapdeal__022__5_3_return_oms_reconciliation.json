  "sql_template": "SELECT\n  r.order_id,\n  r.invoice_number AS return_credit_note,\n  r.charged_amount AS return_amount,\n  o.charged_amount AS original_order_amount,\n  o.current_order_state\nFROM zs_observe.snapdeal_sales_return r\nLEFT JOIN zs_observe.snapdeal_oms o\n  ON r.sub_order_no = o.suborder_code\n  AND o.is_active = true\nWHERE r.is_active = true;",
