  "sql_pattern_id": "sql.snapdeal.10_2_payments_settlement_matching",
  "sql_template": "SELECT\n  p.utr_no_,\n  p.gross_amount AS payment_received,\n  SUM(s.settled_amount) AS sum_of_settlement_lines,\n  p.gross_amount - SUM(s.settled_amount) AS variance\nFROM zs_observe.snapdeal_payments p\nLEFT JOIN zs_observe.snapdeal_settlement s\n  ON p.utr_no_ = s.settlement_id\n  AND s.is_active = true\nWHERE p.is_active = true\nGROUP BY p.utr_no_, p.gross_amount;",
