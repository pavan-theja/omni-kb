  "sql_pattern_id": "sql.snapdeal.8_1_full_settlement_financial_summary",
  "sql_template": "SELECT\n  type,\n  COUNT(*) AS records,\n  SUM(charged_amount) AS gross_gmv,\n  SUM(commission) AS total_commission,\n  SUM(courier_fee) AS courier_fees,\n  SUM(closing_fee) AS closing_fees,\n  SUM(marketing_fee) AS marketing_fees,\n  SUM(payment_collection_fee) AS payment_fees,\n  SUM(discount) AS discounts,\n  SUM(cash_discount_adjustment) AS cashback_adj,\n  SUM(tax_igst_amount + tax_cgst_amount + tax_sgst_amount) AS gst_on_fees,\n  SUM(settled_amount) AS net_settled\nFROM zs_observe.snapdeal_settlement\nWHERE is_active = true\nGROUP BY type\nORDER BY records DESC;",
