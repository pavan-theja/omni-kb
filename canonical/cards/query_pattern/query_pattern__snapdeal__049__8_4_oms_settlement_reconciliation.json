  "sql_pattern_id": "sql.snapdeal.8_4_oms_settlement_reconciliation",
  "sql_template": "SELECT\n  o.invoice_number,\n  o.charged_amount AS oms_charged,\n  o.transaction_type AS oms_type,\n  s.settled_amount,\n  s.commission,\n  s.courier_fee,\n  s.type AS settlement_type,\n  CASE\n    WHEN s.invoice_number IS NULL THEN 'Unmatched in Settlement'\n    ELSE 'Matched'\n  END AS recon_status\nFROM zs_observe.snapdeal_oms o\nLEFT JOIN zs_observe.snapdeal_settlement s\n  ON o.invoice_number = s.invoice_number\n  AND s.is_active = true\n  AND s.transaction_type = 'forward'\nWHERE o.is_active = true\n  AND o.transaction_type = 'forward';",
