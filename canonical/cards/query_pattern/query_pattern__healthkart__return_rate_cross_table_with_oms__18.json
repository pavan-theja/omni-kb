  "sql_pattern": "-- Note: date ranges don't overlap well currently\n-- Use settlement table for more reliable return analysis\nSELECT\n  r.return_count,\n  o.forward_count,\n  ROUND(100.0 * r.return_count / o.forward_count, 2) AS return_rate_pct\nFROM\n  (SELECT COUNT(*) AS return_count FROM zs_observe.healthkart_return WHERE is_active = true) r,\n  (SELECT COUNT(*) AS forward_count FROM zs_observe.healthkart_oms WHERE is_active = true) o",
