  "sql_template": "SELECT\n  COALESCE(b.brand, 'Unknown') AS brand,\n  COUNT(DISTINCT s.sub_order_num) AS orders,\n  SUM(s.charged_amount) AS gmv,\n  AVG(s.charged_amount) AS aov\nFROM zs_observe.meesho_sales s\nLEFT JOIN zs_observe.meesho_brand_mapping b\n  ON s.order_id = b.order_id\n  AND b.is_active = true\nWHERE s.is_active = true\nGROUP BY 1\nORDER BY gmv DESC;",
