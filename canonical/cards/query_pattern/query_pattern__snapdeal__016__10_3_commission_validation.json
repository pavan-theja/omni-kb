  "sql_pattern_id": "sql.snapdeal.10_3_commission_validation",
  "sql_template": "SELECT\n  c.invoice_number,\n  c.total_commission_amount AS commission_invoice,\n  s.commission AS settlement_commission,\n  ABS(c.total_commission_amount - s.commission) AS variance\nFROM zs_observe.snapdeal_commission c\nLEFT JOIN zs_observe.snapdeal_settlement s\n  ON c.invoice_number = s.invoice_number\n  AND s.is_active = true\nWHERE c.is_active = true;",
