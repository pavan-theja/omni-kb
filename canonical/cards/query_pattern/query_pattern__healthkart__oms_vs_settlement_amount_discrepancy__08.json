  "sql_pattern": "-- Compare charged amounts between OMS and Settlement\nSELECT o.order_id,\n  o.charged_amount AS oms_charged,\n  s.charged_amount AS settle_charged,\n  o.charged_amount - s.charged_amount AS diff\nFROM zs_observe.healthkart_oms o\nJOIN zs_observe.healthkart_settlement s\n  ON o.order_id = s.order_id AND s.is_active = true\nWHERE o.is_active = true\n  AND ABS(o.charged_amount - s.charged_amount) > 1",
