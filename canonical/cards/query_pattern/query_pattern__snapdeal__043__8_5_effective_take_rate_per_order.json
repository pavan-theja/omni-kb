  "sql_pattern_id": "sql.snapdeal.8_5_effective_take_rate_per_order",
  "sql_template": "SELECT\n  c.sub_order_no,\n  c.total_commission_amount AS commission,\n  c.tax_amount AS gst_on_commission,\n  o.charged_amount AS order_value,\n  ROUND(100.0 * ABS(c.total_commission_amount) / NULLIF(o.charged_amount, 0), 2) AS take_rate_pct\nFROM zs_observe.snapdeal_commission c\nLEFT JOIN zs_observe.snapdeal_oms o\n  ON c.sub_order_no = o.suborder_code\n  AND o.is_active = true\nWHERE c.is_active = true\n  AND c.transaction_type LIKE '%Vendor Invoice%';",
