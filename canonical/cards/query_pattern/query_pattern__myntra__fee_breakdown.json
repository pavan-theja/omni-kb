  "sql_ref": "sql.myntra.fee_breakdown",
  "sql_template": "SELECT fee_component, SUM(COALESCE(amount, 0)) AS amount\nFROM zs_refined.myntra_settlement s\nCROSS JOIN UNNEST(\n  ARRAY['gross_commission','mp_fees','pick_and_pack_fee','payment_gateway_fee','fixed_fee','freight_charge','freight_charge_gst','reverse_prepaid_charges','reverse_postpaid_charges','marketing_charges_prepaid','marketing_charges_postpaid','royaltycharges_prepaid','royaltycharges_postpaid'],\n  ARRAY[gross_commission, mp_fees, pick_and_pack_fee, payment_gateway_fee, fixed_fee, freight_charge, freight_charge_gst, reverse_prepaid_charges, reverse_postpaid_charges, marketing_charges_prepaid, marketing_charges_postpaid, royaltycharges_prepaid, royaltycharges_postpaid]\n) AS t(fee_component, amount)\nWHERE s.is_active = true\n  AND s.group_level_id = <client_id>\nGROUP BY fee_component\nORDER BY fee_component;",
