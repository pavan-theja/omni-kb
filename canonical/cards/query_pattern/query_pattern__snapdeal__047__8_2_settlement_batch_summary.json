  "sql_template": "SELECT\n  settlement_id,\n  settlement_date,\n  payment_date,\n  COUNT(*) AS line_items,\n  SUM(charged_amount) AS gross_gmv,\n  SUM(settled_amount) AS net_settled,\n  COUNT(DISTINCT invoice_number) AS invoices\nFROM zs_observe.snapdeal_settlement\nWHERE is_active = true\n  AND settlement_id IS NOT NULL\nGROUP BY settlement_id, settlement_date, payment_date\nORDER BY settlement_date DESC;",
