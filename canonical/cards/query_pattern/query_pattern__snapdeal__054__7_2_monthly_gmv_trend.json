  "sql_template": "SELECT\n  CAST(DATE_TRUNC('month', CAST(order_date AS TIMESTAMP)) AS DATE) AS month,\n  COUNT(*) AS orders,\n  COUNT_IF(transaction_type = 'forward') AS forward_orders,\n  COUNT_IF(transaction_type = 'reverse') AS return_orders,\n  SUM(charged_amount) AS gmv\nFROM zs_observe.snapdeal_oms\nWHERE is_active = true\nGROUP BY 1\nORDER BY 1;",
