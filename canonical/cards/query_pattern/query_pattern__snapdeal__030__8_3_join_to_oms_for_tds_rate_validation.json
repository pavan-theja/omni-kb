  "sql_pattern_id": "sql.snapdeal.8_3_join_to_oms_for_tds_rate_validation",
  "sql_template": "SELECT\n  n.sub_order_no,\n  n.gross_amount AS tds_amount,\n  o.charged_amount AS order_value,\n  ROUND(100.0 * ABS(n.gross_amount) / NULLIF(o.charged_amount, 0), 4) AS effective_tds_rate_pct\nFROM zs_observe.snapdeal_non_order n\nLEFT JOIN zs_observe.snapdeal_oms o\n  ON n.sub_order_no = o.suborder_code\n  AND o.is_active = true\nWHERE n.is_active = true\n  AND n.transaction_type IN ('COD TDS INV', 'NCOD TDS INV');",
