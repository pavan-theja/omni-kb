  "sql_pattern_id": "sql.snapdeal.9_5_effective_commission_rate",
  "sql_template": "SELECT\n  ROUND(\n    100.0 * ABS(SUM(commission))\n    / NULLIF(SUM(charged_amount), 0), 2\n  ) AS effective_commission_pct\nFROM zs_observe.snapdeal_settlement\nWHERE is_active = true\n  AND transaction_type = 'forward'\n  AND charged_amount > 0;",
