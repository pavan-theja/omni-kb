  "sql_template": "SELECT\n  transaction_type,\n  current_order_state,\n  COUNT(*) AS orders,\n  SUM(charged_amount) AS total_gmv,\n  SUM(charged_amount_excluding_tax) AS taxable_value,\n  SUM(total_tax) AS total_tax,\n  AVG(charged_amount) AS aov\nFROM zs_observe.snapdeal_oms\nWHERE is_active = true\nGROUP BY transaction_type, current_order_state\nORDER BY orders DESC;",
