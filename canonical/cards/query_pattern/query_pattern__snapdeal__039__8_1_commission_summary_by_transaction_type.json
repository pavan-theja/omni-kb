  "sql_pattern_id": "sql.snapdeal.8_1_commission_summary_by_transaction_type",
  "sql_template": "SELECT\n  transaction_type,\n  COUNT(*) AS records,\n  SUM(total_commission_amount) AS total_commission,\n  SUM(tax_amount) AS total_gst,\n  SUM(courier_fee) AS courier,\n  SUM(marketing_fee) AS marketing,\n  SUM(payment_collection_fee) AS payment_coll\nFROM zs_observe.snapdeal_commission\nWHERE is_active = true\nGROUP BY transaction_type\nORDER BY records DESC;",
