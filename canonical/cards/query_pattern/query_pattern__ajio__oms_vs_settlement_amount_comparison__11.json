  "sql_pattern": "SELECT o.order_id, o.purchase_po_no,\n  o.charged_amount AS customer_price,\n  s.charged_amount AS settlement_price,\n  s.charged_amount - o.charged_amount AS b2b_premium\nFROM zs_observe.ajio_oms o\nJOIN zs_observe.ajio_settlement s\n  ON o.purchase_po_no = s.purchase_po_no\nWHERE o.is_active = true\n  AND s.is_active = true\n  AND o.order_status = 'Delivered'\nLIMIT 20",
