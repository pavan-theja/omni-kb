  "sql_pattern_id": "sql.snapdeal.10_1_oms_settlement_matching",
  "sql_template": "SELECT\n  o.invoice_number,\n  o.charged_amount AS oms_gmv,\n  s.settled_amount AS settlement_net,\n  CASE WHEN s.invoice_number IS NULL THEN 'Not in Settlement' ELSE 'Matched' END AS status\nFROM zs_observe.snapdeal_oms o\nLEFT JOIN zs_observe.snapdeal_settlement s\n  ON o.invoice_number = s.invoice_number\n  AND s.is_active = true\n  AND s.transaction_type = 'forward'\nWHERE o.is_active = true\n  AND o.current_order_state = 'Delivered';",
