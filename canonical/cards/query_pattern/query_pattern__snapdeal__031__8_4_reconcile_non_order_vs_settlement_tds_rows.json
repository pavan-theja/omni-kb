  "sql_pattern_id": "sql.snapdeal.8_4_reconcile_non_order_vs_settlement_tds_rows",
  "sql_template": "SELECT\n  n.sub_order_no,\n  n.gross_amount AS non_order_tds,\n  s.settled_amount AS settlement_tds\nFROM zs_observe.snapdeal_non_order n\nLEFT JOIN zs_observe.snapdeal_settlement s\n  ON n.sub_order_no = s.item_id\n  AND s.is_active = true\n  AND LOWER(s.type) LIKE '%tds%'\nWHERE n.is_active = true;",
