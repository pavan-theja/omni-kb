  "sql_pattern": "SELECT\n  DATE_FORMAT(settlement_date, '%Y-%m') AS month,\n  SUM(charged_amount) AS gross,\n  SUM(gross_commission) AS commission,\n  SUM(mp_fees) AS marketplace_fees,\n  SUM(total_tax_on_charges) AS tax_on_fees,\n  SUM(settled_amount) AS net_settled\nFROM zs_observe.healthkart_settlement\nWHERE is_active = true\nGROUP BY DATE_FORMAT(settlement_date, '%Y-%m')\nORDER BY month",
