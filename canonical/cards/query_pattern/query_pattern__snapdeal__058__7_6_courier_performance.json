  "sql_pattern_id": "sql.snapdeal.7_6_courier_performance",
  "sql_template": "SELECT\n  courier_partner,\n  COUNT(*) AS shipments,\n  COUNT_IF(current_order_state = 'Delivered') AS delivered,\n  COUNT_IF(transaction_type = 'reverse') AS returns,\n  ROUND(100.0 * COUNT_IF(current_order_state = 'Delivered') / COUNT(*), 2) AS delivery_rate_pct\nFROM zs_observe.snapdeal_oms\nWHERE is_active = true\nGROUP BY courier_partner\nORDER BY shipments DESC;",
