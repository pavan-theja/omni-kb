  "formula_sql": "SELECT\n  r.order_id,\n  r.invoice_number,\n  r.charged_amount\nFROM zs_observe.snapdeal_sales_return r\nLEFT JOIN zs_observe.snapdeal_settlement s\n  ON r.invoice_number = s.invoice_number\n  AND s.is_active = true\nWHERE r.is_active = true\n  AND s.invoice_number IS NULL;",
