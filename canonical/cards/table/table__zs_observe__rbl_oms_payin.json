  "source_caveats": [
    "This is a bank statement feed — not a gateway table. Used for the final bank reconciliation layer.",
    "`credit_debit` = 'CR' for incoming credits (settlement receipts from PGs), 'DR' for debits (refunds, fees).",
    "`transaction_details` and `description` contain UTR numbers embedded in text — parse to extract UTRs.",
    "`deposit_amt` / `withdrawl_amt` (note: typo is in source data — \"withdrawl\") and `transaction_amount` may overlap — use `transaction_amount` (Decimal) for calculations.",
    "`other_attributes` may contain JSON with additional bank metadata.",
    "Match `transaction_details` UTRs against settlement UTRs in gateway tables for 3-way reconciliation.",
    "Bank-side evidence only; do not treat as payment gateway platform table or create bank-account cards.",
    "Some financial amount fields are stored as Text; prefer mapped Decimal columns when available or cast explicitly."
  ],
