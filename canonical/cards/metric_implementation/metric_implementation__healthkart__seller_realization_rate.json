  "formula_sql": "SELECT\n  DATE_FORMAT(settlement_date, '%Y-%m') AS month,\n  SUM(settled_amount) AS net_settled,\n  SUM(charged_amount) AS gross_charged,\n  ROUND(100.0 * SUM(settled_amount) / NULLIF(SUM(charged_amount), 0), 2) AS seller_realization_rate_pct\nFROM zs_observe.healthkart_settlement\nWHERE is_active = true\n  AND transaction_type = 'forward'\n  AND order_status = 'Delivered'\nGROUP BY DATE_FORMAT(settlement_date, '%Y-%m')\nORDER BY month",
