  "formula_sql": "SELECT\n  DATE_FORMAT(settlement_date, '%Y-%m') AS month,\n  COUNT(*) AS total,\n  SUM(CASE WHEN order_status = 'RTO' THEN 1 ELSE 0 END) AS rto,\n  ROUND(100.0 * SUM(CASE WHEN order_status = 'RTO' THEN 1 ELSE 0 END) / COUNT(*), 1) AS rto_rate_pct\nFROM zs_observe.healthkart_settlement\nWHERE is_active = true\nGROUP BY DATE_FORMAT(settlement_date, '%Y-%m')\nORDER BY month",
