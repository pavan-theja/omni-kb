  "formula_sql": "SELECT\n  ROUND(100.0 * COUNT(DISTINCT r.parent_id) / COUNT(DISTINCT o.order_id), 1) AS return_rate_pct\nFROM zs_observe.ajio_oms o\nLEFT JOIN zs_observe.ajio_reverse r\n  ON o.order_id = r.parent_id AND r.is_active = true\nWHERE o.is_active = true\n  AND o.order_status = 'Delivered'",
