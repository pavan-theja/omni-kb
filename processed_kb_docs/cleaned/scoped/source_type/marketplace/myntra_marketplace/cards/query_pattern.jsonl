ND s.transaction_type = 'reverse'\n AND s.is_active = true\n AND s.group_level_id = r.group_level_id\nWHERE r.is_active = true\n  AND r.group_level_id = <client_id>\nGROUP BY r.order_id, r.item_id;", "status": "draft", "summary": "Myntra query pattern: Reverse Settlement Reconciliation.", "validation_test_ids": ["validation_test.myntra.relationship_keys_present"]}
