# Copy this file to cognee/.env and set provider credentials before starting Cognee.
#
# Official Cognee Docker docs expose the API at http://localhost:8000 and use
# /api/v1/* endpoints for add, cognify, and search.

# Cognee runtime provider selection. `vertex` uses LiteLLM's Vertex AI route
# inside the Cognee container; `gemini` uses a Google AI Studio/Gemini API key.
COGNEE_LLM_PROVIDER=azure
COGNEE_EMBEDDING_PROVIDER=azure

AZURE_API_BASE=
AZURE_API_KEY=
AZURE_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional: Cognee Gemini provider and Gemini API-key embeddings.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# Optional: Vertex AI LLM and embeddings for Cognee.
# For Cognee Docker, put the service account JSON at
# cognee/runtime/google-credentials/service-account.json and use the container
# path below. Do not commit real key material.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_QUOTA_PROJECT=
VERTEX_AI_LOCATION=asia-south1
VERTEX_AI_LLM_MODEL=gemini-2.0-flash
VERTEX_AI_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_AI_EMBEDDING_DIMENSIONALITY=1536
VERTEX_AI_AUTO_TRUNCATE=true
GOOGLE_APPLICATION_CREDENTIALS=/app/.google-credentials/service-account.json
VERTEX_AI_SERVICE_ACCOUNT_FILE=
VERTEX_AI_SERVICE_ACCOUNT_JSON=
# Cognee Docker Vertex runtime should use GOOGLE_APPLICATION_CREDENTIALS.
VERTEX_AI_ACCESS_TOKEN=

DB_PROVIDER=sqlite
GRAPH_DATABASE_PROVIDER=kuzu
VECTOR_DB_PROVIDER=lancedb

SYSTEM_ROOT_DIRECTORY=/app/.cognee_system
DATA_ROOT_DIRECTORY=/app/.data_storage

REQUIRE_AUTHENTICATION=false
ENABLE_BACKEND_ACCESS_CONTROL=false
CORS_ALLOWED_ORIGINS=*
TELEMETRY_DISABLED=true
COGNEE_SKIP_CONNECTION_TEST=false
LOG_LEVEL=INFO
ENV=local
